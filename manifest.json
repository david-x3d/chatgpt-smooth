{
  "manifest_version": 3,
  "name": "Claude Smooth",
  "version": "3.1.2",
  "description": "Smoother animations on claude.ai, without changing the look.",
  "homepage_url": "https://github.com/david-x3d/claude-smooth",
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "css": ["smooth.css"],
      "js": ["smooth.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Claude Smooth",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-smooth@david-x3d",
      "strict_min_version": "142.0",
      "update_url": "https://github.com/david-x3d/claude-smooth/releases/latest/download/updates.json",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}

{
  "manifest_version": 3,
  "name": "ChatGPT Smooth",
  "version": "3.1.6",
  "description": "Smoother animations on chatgpt.com, without changing the look.",
  "homepage_url": "https://github.com/david-x3d/chatgpt-smooth",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "css": [
        "smooth.css"
      ],
      "js": [
        "smooth.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "ChatGPT Smooth",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-smooth@david-x3d",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://github.com/david-x3d/chatgpt-smooth/releases/latest/download/updates.json"
    }
  }
}
